# ---------------------------------------------------------------------------
# Referral Ecosystem Generator — environment configuration
# Every integration is optional. Missing credentials disable that feature
# honestly (it is reported as "not configured", never simulated).
# ---------------------------------------------------------------------------

# Public base URL (used for Stripe redirect URLs). On Vercel this is derived automatically.
APP_URL=http://localhost:3000
# development | preview | production (Vercel sets VERCEL_ENV automatically)
APP_ENV=

# --- Private beta --------------------------------------------------------------
# Invite-only access. Codes are label:code pairs; remove a pair to revoke access.
BETA_MODE=false
BETA_INVITES=
BETA_SECRET=
# Unlocks /admin (funnel analytics, AI spend)
ADMIN_KEY=

# Development/testing mode: shows a banner and lets you unlock paid features
# WITHOUT payment. Never enable in production.
DEV_MODE=true

# --- AI provider (optional) -------------------------------------------------
# anthropic | openai | none. If unset, the first provider with a key is used.
# Without a key, the curated knowledge-base engine produces the analysis.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — reasoning effort (both providers). Lower = faster and cheaper.
LLM_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Who may trigger AI: none (default: industry playbooks only) | testers (invited only) | all.
AI_ACCESS=none
# Hard caps (USD, estimated from token usage x prices below). Also set a limit in the provider dashboard.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=40
AI_PER_TESTER_DAILY_RUNS=5
AI_ESTIMATED_RUN_COST_USD=0.75
# Per-million-token list prices used for the estimate (defaults: gpt-5.5 $5/$30, claude-opus-5-5 $4/$20)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_MAX_OUTPUT_TOKENS=12000
# Partner categories analysed per parallel AI call (smaller = lower latency)
AI_BATCH_SIZE=4
# knowledge_base (default: fall back to the curated analysis) | error
AI_FALLBACK=knowledge_base

# --- Named-organisation discovery (paid feature — DISABLED pending licensing) --
# Leave false until docs/internal/data-licensing.md decisions are signed off.
COMPANY_RESEARCH_ENABLED=false
# google_places | brave | none. NOTE: Google Maps Platform terms restrict exporting Places
# content outside Google's services; Brave's general terms prohibit retaining results.
DISCOVERY_PROVIDER=
GOOGLE_PLACES_API_KEY=
BRAVE_SEARCH_API_KEY=
DISCOVERY_MAX_RESULTS=8

# --- Payments (optional) ----------------------------------------------------
# Use TEST keys (sk_test_...). Live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_CURRENCY=usd
# Prices in cents (unvalidated starting prices — configurable)
PRICE_BASIC_CENTS=14900
PRICE_COMPREHENSIVE_CENTS=29900
# HMAC secret for signed access tokens. Generate: openssl rand -base64 32
ENTITLEMENT_SECRET=
# Shown as "request a quote" for Advanced Research & Execution
CONTACT_EMAIL=

# --- Persistence -------------------------------------------------------------
# memory | file | postgres. Default: postgres if DATABASE_URL is set, else file.
# Use postgres (e.g. Supabase) on serverless hosts such as Vercel/Netlify.
STORE_DRIVER=
DATA_DIR=.data
# Supabase transaction-pooler URI (port 6543), without ?sslmode
DATABASE_URL=
# Optional: Supabase CA certificate (use \n for newlines) to enable full TLS verification
DATABASE_CA_CERT=

# --- Limits ------------------------------------------------------------------
FREE_CATEGORY_LIMIT=5
RATE_LIMIT_PER_MINUTE=12
